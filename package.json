{
  "name": "study-hub-rpg",
  "productName": "Study Hub RPG",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "main.cjs",
  "scripts": {
    "dev": "vite",
    "dev:all": "start start-tts.bat && vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "optimize-images": "node scripts/optimize-images.mjs",
    "tts": "tts-env\\Scripts\\python.exe local_tts_server.py",
    "tts:setup": "uv venv --python 3.11 --allow-existing tts-env && uv pip install --python tts-env\\Scripts\\python.exe \"numpy<2\" \"onnxruntime<=1.17.3\" piper-tts fastapi \"uvicorn[standard]\" groq boto3 python-multipart",
    "electron:start": "electron .",
    "electron:dev": "npm run build && electron .",
    "electron": "npm run build && electron .",
    "desktop": "npm run build && cross-env NODE_ENV=production electron .",
    "pack": "npm run build && npx --no electron-packager . \"Study Hub RPG\" --platform=win32 --arch=x64 --out=dist_desktop --overwrite --icon=public/icon.ico --prune=false --extra-resource=tts-env --extra-resource=local_tts_server.py --extra-resource=server.py --extra-resource=voices --ignore=\"^/(\\.git|dist_desktop|src|\\.agents|win32-x64-template|__pycache__)(/|$)\""
  },
  "dependencies": {
    "@aws-sdk/client-polly": "^3.1114.0",
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "@tailwindcss/vite": "^4.3.3",
    "@xyflow/react": "^12.11.6",
    "lucide-react": "^1.37.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-icons": "^5.7.0",
    "react-is": "^19.2.8",
    "react-router-dom": "^7.11.0",
    "recharts": "^3.9.2",
    "tailwindcss": "^4.3.3",
    "three": "^0.185.1",
    "vite-plugin-pwa": "^1.3.0"
  },
  "devDependencies": {
    "@electron/packager": "^18.4.4",
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "cross-env": "^7.0.3",
    "electron": "^34.3.0",
    "electron-builder": "^25.1.8",
    "eslint": "^10.6.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "sharp": "^0.35.3",
    "vite": "^8.1.1"
  },
  "allowScripts": {
    "electron@34.5.8": true
  }
}
